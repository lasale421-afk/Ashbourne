# Token GitLab - créer un token avec les scopes read_api et read_repository
# GitLab → Settings → Access Tokens → rôle Reporter minimum
GITLAB_TOKEN=ton_token_gitlab

# Mail - rempli uniquement si SMTP interne disponible (optionnel)
SMTP_USER=ton_email@iliad-free.fr
SMTP_PASSWORD=ton_mot_de_passe_mail
RECIPIENTS=destinataire@iliad-free.fr
STREAMLIT_URL=http://localhost:8501